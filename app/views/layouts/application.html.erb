<!DOCTYPE html>
<html>
  <head>
    <title>注文フォーム</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <% if notice.present? %>
      <div class="alert alert-success alert-dismissible fade show mb-0" role="alert">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="alert alert-danger alert-dismissible fade show mb-0" role="alert">
        <%= alert %>
      </div>
    <% end %>

    <% if user_signed_in? %>
      <div class="container mt-3">
        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded shadow-sm">
          <div class="border-start border-primary border-4 ps-2 fw-bold text-secondary">
            ログイン中: <%= current_user.email %>
          </div>
          <div>
            <%= button_to "ログアウト", destroy_user_session_path, method: :delete, form: { data: { turbo: "false" } }, class: "btn btn-outline-secondary btn-sm" %>
          </div>
        </div>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
